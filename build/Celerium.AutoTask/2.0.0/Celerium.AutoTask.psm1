#Region '.\Private\ApiCalls\Invoke-AutoTaskRequest.ps1' -1

function Invoke-AutoTaskRequest {
<#
    .SYNOPSIS
        Makes an API request to the AutoTask API

    .DESCRIPTION
        The Invoke-AutoTaskRequest cmdlet invokes an API request to the AutoTask API

        This is an internal function that is used by all public functions

        GET requests & the POST query requests (/query & /query/count) are read requests.
        Any other request is a write request. Write requests are never retried

        By default only the data of a response is returned, such as the items of a query
        or the item of a single resource. Use -Raw to return the full response

    .PARAMETER Method
        Defines the type of API method to use

        Allowed values:
        'GET', 'POST', 'PUT', 'PATCH', 'DELETE'

    .PARAMETER ResourceURI
        Defines the resource uri (url) path to use when creating the API call, such as /V1.0/Companies/query

        The path is appended to the base URI defined by Add-AutoTaskBaseURI

    .PARAMETER UriFilter
        Hashtable of query string parameters to append to the resource uri, such as @{ search = '{...}' }

        The values are url encoded

    .PARAMETER Data
        Optional object to send as the JSON request body

        A string is sent as is and must already be JSON, any other object is converted to JSON

    .PARAMETER AllResults
        Returns all items from an endpoint by following the next page url of every page of a query

        Ignored for write requests

    .PARAMETER Raw
        Returns the full API response object instead of only the data

    .PARAMETER WriteRequest
        Marks the request as a write request so that it is never retried, even when it uses the GET method

        Every request that is not a GET request or a POST query request is always a write request

    .EXAMPLE
        Invoke-AutoTaskRequest -Method GET -ResourceURI '/V1.0/Companies/0'

        Gets the company with the ID 0

    .EXAMPLE
        Invoke-AutoTaskRequest -Method POST -ResourceURI '/V1.0/Companies/query' -Data '{"filter":[{"op":"eq","field":"isActive","value":true}]}' -AllResults

        Returns every active company by requesting every page of the query

    .EXAMPLE
        Invoke-AutoTaskRequest -Method PATCH -ResourceURI '/V1.0/Companies' -Data @{ id = 12345; phone = '555-555-5555' }

        Sends a write request with a JSON body

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Invoke-AutoTaskRequest.html
#>

    [CmdletBinding()]
    param (
        [Parameter()]
        [ValidateSet('GET', 'POST', 'PUT', 'PATCH', 'DELETE')]
        [string]$Method = 'GET',

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$ResourceURI,

        [Parameter()]
        [hashtable]$UriFilter,

        [Parameter()]
        $Data,

        [Parameter()]
        [switch]$AllResults,

        [Parameter()]
        [switch]$Raw,

        [Parameter()]
        [switch]$WriteRequest
    )

    begin {

        $FunctionName   = $MyInvocation.MyCommand.Name
        $ParameterName  = $FunctionName + '_Parameters' -replace '-','_'

        $BaseUri = Get-AutoTaskBaseURI -WarningAction SilentlyContinue
        $ApiKey  = Get-AutoTaskAPIKey -AsPlainText -WarningAction SilentlyContinue
        if (-not $BaseUri -or -not $ApiKey -or -not $ApiKey.Username -or -not $ApiKey.Password -or -not $ApiKey.ApiIntegrationCode) {
            throw "No authentication method or base uri found, please run Add-AutoTaskAPIKey & Add-AutoTaskBaseURI to continue"
        }

        # Windows PowerShell does not always negotiate TLS 1.2 by default
        if ($PSEdition -eq 'Desktop') {
            [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        }

        $RequestHeaders = @{
            'ApiIntegrationCode'    = $ApiKey.ApiIntegrationCode
            'UserName'              = $ApiKey.Username
            'Secret'                = $ApiKey.Password
            'Accept'                = 'application/json'
        }
        $ApiKey = $null

        # Only the path is cleaned up, a double slash in the query string can be part of a search value
        $PathPart, $QueryPart = $ResourceURI -split '\?', 2
        $ResourceURI = '/' + ($PathPart.TrimStart('/') -replace '/{2,}', '/')
        if ($QueryPart) { $ResourceURI = $ResourceURI + '?' + $QueryPart }

        # GET requests & POST queries do not change any data
        $IsWrite        = $WriteRequest -or ( $Method -ne 'GET' -and $PathPart -notmatch '/query(/count)?/?$' )
        $PageResults    = $AllResults -and -not $IsWrite

        $BaseAuthority  = ([System.Uri]$BaseUri).GetLeftPart([System.UriPartial]::Authority)

    }

    process {

        Write-Verbose "[ $FunctionName ] - Running the [ $($PSCmdlet.ParameterSetName) ] parameterSet"

        $AllResponseData    = [System.Collections.Generic.List[object]]::new()
        $LastResponse       = $null
        $Page               = 1

        $QueryString = ''
        if ($UriFilter) {
            $Keys = [string[]]@($UriFilter.Keys)
            [System.Array]::Sort($Keys, [System.StringComparer]::Ordinal)
            $QueryString = (@(foreach ($Key in $Keys) {
                $Value = $UriFilter[$Key]
                if ($Value -is [bool]) { $Value = $Value.ToString().ToLowerInvariant() }
                [System.Uri]::EscapeDataString($Key) + '=' + [System.Uri]::EscapeDataString("$Value")
            })) -join '&'
        }

        $TargetUri = $BaseUri + $ResourceURI
        if ($QueryString) { $TargetUri = $TargetUri + $(if ($TargetUri.Contains('?')) { '&' } else { '?' }) + $QueryString }

        do {

            $InvokeParams = @{
                Method          = $Method
                Uri             = $TargetUri
                Headers         = $RequestHeaders
                UserAgent       = $AutoTaskModuleUserAgent
                UseBasicParsing = $true
                ErrorAction     = 'Stop'
            }

            if ($PSBoundParameters.ContainsKey('Data')) {
                $InvokeParams.Body          = if ($Data -is [string]) { $Data } else { ConvertTo-Json -InputObject $Data -Depth $AutoTaskModuleJSONConversionDepth -Compress }
                $InvokeParams.ContentType   = 'application/json; charset=utf-8'
            }

            # Keeps the API secret & integration code out of the debug variable
            $DebugParams = @{} + $InvokeParams
            $DebugParams.Headers = @{} + $RequestHeaders
            $DebugParams.Headers['Secret']              = '*******'
            $DebugParams.Headers['ApiIntegrationCode']  = '*******'
            Set-Variable -Name $ParameterName -Value $DebugParams -Scope Global -Force -Confirm:$false

            $RetryCount = 0
            $RetryMax   = 3
            $Response   = $null

            while ($null -eq $Response) {

                try {
                    $WebResponse    = Invoke-WebRequest @InvokeParams
                    $Bytes          = $WebResponse.RawContentStream.ToArray()
                    $ContentType    = "$($WebResponse.Headers['Content-Type'])"

                    if ($ContentType -and $ContentType -notmatch 'json|text|xml|html') {
                        # Binary data is returned as a byte array
                        $Response = $Bytes
                    }
                    else {
                        # Windows PowerShell decodes responses without a charset as ISO-8859-1
                        $Content = [System.Text.Encoding]::UTF8.GetString($Bytes)

                        if ($ContentType -match 'json' -or $Content.TrimStart() -match '^[\{\[]') {
                            if ($Content.Trim()) { $Response = $Content | ConvertFrom-Json }

                            # An array with zero or one item is not returned as an array when it is converted from JSON
                            if ($Content.TrimStart().StartsWith('[')) { $Response = @($Response | Where-Object { $null -ne $_ }) }
                        }
                        else { $Response = $Content }
                    }

                    if ($null -eq $Response -or ($Response -is [string] -and -not $Response.Trim())) { $Response = [PSCustomObject]@{} }
                }
                catch {

                    $ErrorRecord    = $_
                    $StatusCode     = $null
                    $RetryAfter     = $null

                    if ($ErrorRecord.Exception.Response) {
                        $StatusCode = [int]$ErrorRecord.Exception.Response.StatusCode
                        try {
                            $ResponseHeaders = $ErrorRecord.Exception.Response.Headers
                            if ($ResponseHeaders.GetType().Name -eq 'HttpResponseHeaders') {
                                if ($ResponseHeaders.RetryAfter.Delta) { $RetryAfter = [int]$ResponseHeaders.RetryAfter.Delta.TotalSeconds }
                            }
                            elseif ($ResponseHeaders['Retry-After']) { $RetryAfter = [int]$ResponseHeaders['Retry-After'] }
                        }
                        catch { Write-Verbose "[ $FunctionName ] - Unable to read the Retry-After header" }
                    }

                    # Prefer the error detail returned by the API, AutoTask returns { "errors": [ "..." ] }
                    $Detail = $ErrorRecord.Exception.Message
                    if ($ErrorRecord.ErrorDetails.Message) {
                        try {
                            $ApiError = $ErrorRecord.ErrorDetails.Message | ConvertFrom-Json -ErrorAction Stop
                            if ($ApiError.errors)           { $Detail = (@($ApiError.errors) | ForEach-Object { "$_" }) -join '; ' }
                            elseif ($ApiError.message)      { $Detail = "$($ApiError.message)" }
                            elseif ($ApiError.Message)      { $Detail = "$($ApiError.Message)" }
                            else                            { $Detail = $ErrorRecord.ErrorDetails.Message }
                        }
                        catch { $Detail = $ErrorRecord.ErrorDetails.Message }
                    }

                    # A write request is never sent again because it could be applied twice
                    $Retryable = (-not $IsWrite) -and ( ( $null -eq $StatusCode ) -or ( $StatusCode -in 429, 502, 503, 504 ) )

                    if (-not $Retryable) {
                        Write-Warning 'The [ Invoke_AutoTaskRequest_Parameters & CmdletName_Parameters ] variables can provide extra details'
                        switch ($StatusCode) {
                            401     { throw "Invoke-AutoTaskRequest : [ 401 ] Unauthorized, verify the API username, secret, & integration code - [ $ResourceURI ]" }
                            403     { throw "Invoke-AutoTaskRequest : [ 403 ] Forbidden, the API user is not allowed to access this resource - [ $ResourceURI ]" }
                            404     { throw "Invoke-AutoTaskRequest : [ 404 ] URI not found - [ $ResourceURI ]" }
                            default { throw "Invoke-AutoTaskRequest : [ $StatusCode ] $Detail - [ $ResourceURI ]" }
                        }
                    }

                    $RetryCount++
                    if ($RetryCount -ge $RetryMax) {
                        throw "Invoke-AutoTaskRequest : Maximum retry attempts reached [ $RetryCount/$RetryMax ] - [ $StatusCode ] $Detail - [ $ResourceURI ]"
                    }

                    $WaitTime = [Math]::Min( [Math]::Pow(2, $RetryCount) + (Get-Random -Minimum 0 -Maximum 5), 60 )
                    if ($RetryAfter) { $WaitTime = [Math]::Min($RetryAfter, 120) }

                    Write-Warning "Invoke-AutoTaskRequest : [ $StatusCode ] Retrying request [ $ResourceURI ] in [ $WaitTime ] seconds - Attempt [ $RetryCount/$RetryMax ]"
                    Start-Sleep -Seconds $WaitTime

                }

            }

            $LastResponse   = $Response
            $TargetUri      = $null

            $HasItems = $Response -is [System.Management.Automation.PSCustomObject] -and $Response.PSObject.Properties['items']

            if ($HasItems) {

                foreach ($Item in @($Response.items)) { if ($null -ne $Item) { $AllResponseData.Add($Item) } }
                Write-Verbose "[ $FunctionName ] - Processing [ $(@($Response.items).Count) ] items from page [ $Page ]"

                $NextPageUrl = if ($Response.PSObject.Properties['pageDetails']) { "$($Response.pageDetails.nextPageUrl)" } else { '' }

                if ($PageResults -and $NextPageUrl) {

                    # The credentials are only sent to the AutoTask base uri
                    $ParsedNext = $null
                    if ([System.Uri]::TryCreate($NextPageUrl, [System.UriKind]::Absolute, [ref]$ParsedNext) -and $ParsedNext.GetLeftPart([System.UriPartial]::Authority) -eq $BaseAuthority) {
                        $TargetUri = $NextPageUrl
                        $Page++
                    }
                    else { Write-Warning "Invoke-AutoTaskRequest : The next page url is not on the base uri [ $BaseAuthority ], no more pages are requested" }

                }

            }

        } while ($TargetUri)

        $IsItems = $LastResponse -is [System.Management.Automation.PSCustomObject] -and $LastResponse.PSObject.Properties['items']

        if ($Raw) {
            if ($PageResults -and $IsItems -and $Page -gt 1) {
                return [PSCustomObject]@{
                    items       = $AllResponseData.ToArray()
                    pageDetails = $LastResponse.pageDetails
                }
            }
            return $LastResponse
        }

        if ($IsItems) { return $AllResponseData.ToArray() }

        if ($LastResponse -is [System.Management.Automation.PSCustomObject] -and $LastResponse.PSObject.Properties['item'] -and @($LastResponse.PSObject.Properties).Count -eq 1) {
            return $LastResponse.item
        }

        if ($LastResponse -is [byte[]]) { return ,$LastResponse }

        return $LastResponse

    }

    end {}

}
#EndRegion '.\Private\ApiCalls\Invoke-AutoTaskRequest.ps1' 325
#Region '.\Private\ApiCalls\Resolve-AutoTaskResource.ps1' -1

function Resolve-AutoTaskResource {
<#
    .SYNOPSIS
        Resolves an AutoTask resource & operation to a request uri

    .DESCRIPTION
        The Resolve-AutoTaskResource cmdlet finds an operation of a resource in the resource map
        and replaces the placeholders of its path, such as {parentId} & {id}, with the provided values

        An error is thrown when the resource or the operation does not exist, when the public function
        does not support the operation, or when the number of values does not match the placeholders

    .PARAMETER Resource
        Defines the name of the resource, such as Companies or CompanyAlertsChild

        The name is not case sensitive

    .PARAMETER Operation
        Defines the name of the operation, such as Query, QueryItem, CreateEntity, PatchEntity, or DeleteEntity

        Show-AutoTaskResource lists the operations of every resource

    .PARAMETER CommandName
        Defines the public function that makes the request, only the operations that the
        function supports are allowed

    .PARAMETER PathValue
        Defines the values of the path placeholders in the order that they appear in the path

        For a child resource the first value is the parent ID & the second value is the child ID

    .EXAMPLE
        Resolve-AutoTaskResource -Resource Companies -Operation QueryItem -PathValue 12345

        Returns the GET method & the /V1.0/Companies/12345 resource uri

    .EXAMPLE
        Resolve-AutoTaskResource -Resource CompanyAlertsChild -Operation QueryItem -PathValue 12345, 67

        Returns the GET method & the /V1.0/Companies/12345/Alerts/67 resource uri

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Resolve-AutoTaskResource.html
#>

    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    Param (
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Resource,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Operation,

        [Parameter(Mandatory = $false)]
        [ValidateSet('Get-AutoTaskResource', 'New-AutoTaskBody', 'New-AutoTaskResource', 'Set-AutoTaskResource', 'Remove-AutoTaskResource')]
        [string]$CommandName,

        [Parameter(Mandatory = $false)]
        [AllowEmptyCollection()]
        [object[]]$PathValue = @()
    )

    begin {}

    process {

        $ResourceOperations = @(Get-AutoTaskResourceOperation -Resource $Resource)
        if ($ResourceOperations.Count -eq 0) {
            throw "The [ $Resource ] resource was not found. Run Show-AutoTaskResource to list the available resources"
        }

        $Supported = if ($CommandName) { @(Get-AutoTaskResourceOperation -Resource $Resource -CommandName $CommandName) } else { $ResourceOperations }

        $Entry = $Supported | Where-Object { $_.Operation -eq $Operation } | Select-Object -First 1
        if (-not $Entry) {
            $Names  = @($Supported | ForEach-Object { $_.Operation } | Select-Object -Unique)
            $Using  = if ($CommandName) { " with $CommandName" } else { '' }
            $List   = if ($Names.Count) { $Names -join ', ' } else { 'none' }
            throw "The [ $($ResourceOperations[0].Resource) ] resource does not support the [ $Operation ] operation$Using. Supported operations: $List"
        }

        $Placeholders = @([regex]::Matches($Entry.Path, '\{[^}]+\}') | ForEach-Object { $_.Value })
        $Values       = @($PathValue | Where-Object { $null -ne $_ -and "$_" -ne '' })

        if ($Values.Count -ne $Placeholders.Count) {
            throw "The [ $($Entry.Operation) ] operation of the [ $($Entry.Resource) ] resource ( $($Entry.Path) ) requires [ $($Placeholders.Count) ] ID value(s) $(if ($Placeholders.Count) { "for $($Placeholders -join ', ') " })but [ $($Values.Count) ] were provided"
        }

        $ResourceUri = $Entry.Path
        for ($Index = 0; $Index -lt $Placeholders.Count; $Index++) {
            $Position       = $ResourceUri.IndexOf($Placeholders[$Index])
            $ResourceUri    = $ResourceUri.Substring(0, $Position) + [System.Uri]::EscapeDataString("$($Values[$Index])") + $ResourceUri.Substring($Position + $Placeholders[$Index].Length)
        }

        [PSCustomObject]@{
            Resource        = $Entry.Resource
            Operation       = $Entry.Operation
            Method          = $Entry.Method
            Path            = $Entry.Path
            ResourceUri     = $ResourceUri
            Placeholders    = $Placeholders
        }

    }

    end {}

}
#EndRegion '.\Private\ApiCalls\Resolve-AutoTaskResource.ps1' 115
#Region '.\Private\ApiKeys\Add-AutoTaskAPIKey.ps1' -1

function Add-AutoTaskAPIKey {
<#
    .SYNOPSIS
        Sets the API username, secret, & integration code used to authenticate all API calls

    .DESCRIPTION
        The Add-AutoTaskAPIKey cmdlet sets the API username, secret, & integration code which
        are used to authenticate all API calls made to the AutoTask API

        The username & integration code are stored in memory as plain text & the secret is
        stored in memory as a SecureString

        AutoTask API users & their credentials are created in the AutoTask web interface
            Admin > Resources (Users) > New API User

        The API tracking identifier of the API user is the integration code

    .PARAMETER ApiUsername
        Defines the username of the API user

    .PARAMETER ApiSecretKey
        Defines the secret (password) of the API user as plain text

        If neither ApiSecretKey nor ApiKeySecureString is defined the cmdlet will prompt you
        to enter the secret which will be stored as a SecureString

    .PARAMETER ApiKeySecureString
        Input a SecureString object containing the secret of the API user

    .PARAMETER ApiIntegrationCode
        Defines the API integration code (tracking identifier) of the API user

    .EXAMPLE
        Add-AutoTaskAPIKey -ApiUsername 'api@example.com' -ApiIntegrationCode '12345'

        Prompts to enter in the API secret which will be stored as a SecureString

    .EXAMPLE
        Add-AutoTaskAPIKey -ApiUsername 'api@example.com' -ApiIntegrationCode '12345' -ApiSecretKey '12345'

        Converts the secret to a SecureString and stores the values in global variables

    .EXAMPLE
        '12345' | Add-AutoTaskAPIKey -ApiUsername 'api@example.com' -ApiIntegrationCode '12345'

        The secret is passed in from the pipeline

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Add-AutoTaskAPIKey.html
#>

    [CmdletBinding(DefaultParameterSetName = 'AsPlainText')]
    [Alias('Set-AutoTaskAPIKey')]
    Param (
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$ApiUsername,

        [Parameter(Mandatory = $false, ValueFromPipeline = $true, ParameterSetName = 'AsPlainText')]
        [AllowEmptyString()]
        [string]$ApiSecretKey,

        [Parameter(Mandatory = $true, ParameterSetName = 'AsSecureString')]
        [ValidateNotNullOrEmpty()]
        [securestring]$ApiKeySecureString,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$ApiIntegrationCode
    )

    begin {}

    process {

        switch ($PSCmdlet.ParameterSetName) {

            'AsPlainText'       {
                if ($ApiSecretKey) {
                    $SecureString = ConvertTo-SecureString $ApiSecretKey -AsPlainText -Force
                }
                else {
                    $SecureString = Read-Host -Prompt 'Please enter your API secret' -AsSecureString
                }
            }

            'AsSecureString'    { $SecureString = $ApiKeySecureString }

        }

        Set-Variable -Name 'AutoTaskModuleApiUsername'          -Value $ApiUsername         -Option ReadOnly -Scope Global -Force
        Set-Variable -Name 'AutoTaskModuleApiSecretKey'         -Value $SecureString        -Option ReadOnly -Scope Global -Force
        Set-Variable -Name 'AutoTaskModuleApiIntegrationCode'   -Value $ApiIntegrationCode  -Option ReadOnly -Scope Global -Force

    }

    end {}

}
#EndRegion '.\Private\ApiKeys\Add-AutoTaskAPIKey.ps1' 103
#Region '.\Private\ApiKeys\Get-AutoTaskAPIKey.ps1' -1

function Get-AutoTaskAPIKey {
<#
    .SYNOPSIS
        Gets the AutoTask API username, secret, & integration code

    .DESCRIPTION
        The Get-AutoTaskAPIKey cmdlet gets the AutoTask API username, secret, & integration code
        from the global variables and returns them as an object

        By default the secret is returned as a SecureString

    .PARAMETER AsPlainText
        Decrypt and return the API secret in plain text

    .EXAMPLE
        Get-AutoTaskAPIKey

        Gets the API values and returns them as an object with the secret as a SecureString

    .EXAMPLE
        Get-AutoTaskAPIKey -AsPlainText

        Gets the API values and returns them as an object with the secret as plain text

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Get-AutoTaskAPIKey.html
#>

    [CmdletBinding(DefaultParameterSetName = 'Index')]
    Param (
        [Parameter(Mandatory = $false)]
        [switch]$AsPlainText
    )

    begin {}

    process {

        try {

            if ($AutoTaskModuleApiSecretKey) {

                if ($AsPlainText) {
                    $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($AutoTaskModuleApiSecretKey)
                    [PSCustomObject]@{
                        Username            = $AutoTaskModuleApiUsername
                        Password            = [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($BSTR)
                        ApiIntegrationCode  = $AutoTaskModuleApiIntegrationCode
                    }
                }
                else {
                    [PSCustomObject]@{
                        Username            = $AutoTaskModuleApiUsername
                        Password            = $AutoTaskModuleApiSecretKey
                        ApiIntegrationCode  = $AutoTaskModuleApiIntegrationCode
                    }
                }

            }
            else { Write-Warning "The AutoTask API secret is not set. Run Add-AutoTaskAPIKey to set the API values" }

        }
        catch {
            Write-Error $_
        }
        finally {
            if ($BSTR) { [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($BSTR) }
        }

    }

    end {}

}
#EndRegion '.\Private\ApiKeys\Get-AutoTaskAPIKey.ps1' 78
#Region '.\Private\ApiKeys\Remove-AutoTaskAPIKey.ps1' -1

function Remove-AutoTaskAPIKey {
<#
    .SYNOPSIS
        Removes the API username, secret, & integration code from the global variables

    .DESCRIPTION
        The Remove-AutoTaskAPIKey cmdlet removes the API username, secret, & integration code
        from the global variables

    .EXAMPLE
        Remove-AutoTaskAPIKey

        Removes the API values from the global variables

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Remove-AutoTaskAPIKey.html
#>

    [CmdletBinding(DefaultParameterSetName = 'Destroy', SupportsShouldProcess, ConfirmImpact = 'None')]
    Param ()

    begin {}

    process {

        if ([bool]$AutoTaskModuleApiUsername -or [bool]$AutoTaskModuleApiSecretKey -or [bool]$AutoTaskModuleApiIntegrationCode) {
            if ($PSCmdlet.ShouldProcess('AutoTaskModuleApiUsername, AutoTaskModuleApiSecretKey, AutoTaskModuleApiIntegrationCode')) {
                Remove-Variable -Name 'AutoTaskModuleApiUsername' -Scope Global -Force -ErrorAction SilentlyContinue
                Remove-Variable -Name 'AutoTaskModuleApiSecretKey' -Scope Global -Force -ErrorAction SilentlyContinue
                Remove-Variable -Name 'AutoTaskModuleApiIntegrationCode' -Scope Global -Force -ErrorAction SilentlyContinue
            }
        }
        else { Write-Warning "The AutoTask API values are not set. Nothing to remove" }

    }

    end {}

}
#EndRegion '.\Private\ApiKeys\Remove-AutoTaskAPIKey.ps1' 43
#Region '.\Private\ApiKeys\Test-AutoTaskAPIKey.ps1' -1

function Test-AutoTaskAPIKey {
<#
    .SYNOPSIS
        Test the AutoTask API username, secret, & integration code

    .DESCRIPTION
        The Test-AutoTaskAPIKey cmdlet tests the base URI & API values that
        are defined by the Add-AutoTaskBaseURI & Add-AutoTaskAPIKey cmdlets

        Helpful when needing to validate general functionality or when using
        RMM deployment tools

        The test makes a single read-only GET query that only asks for the ID of one company

        A 200 status code means the base URI & API values are valid. A 401 status code means
        the API values were not accepted & a 403 status code means the API user is not
        allowed to read companies

    .PARAMETER BaseURI
        Define the base URI for the AutoTask API connection
        using AutoTask's URI or a custom URI

        By default the value used is the one defined by the
        Add-AutoTaskBaseURI function

    .EXAMPLE
        Test-AutoTaskAPIKey

        Tests the base URI & API values that are defined by the
        Add-AutoTaskBaseURI & Add-AutoTaskAPIKey cmdlets

    .EXAMPLE
        Test-AutoTaskAPIKey -BaseURI https://myapi.gateway.celerium.org

        Tests the defined base URI & the API values that were defined by
        the Add-AutoTaskAPIKey cmdlet

        The full test uri in this example is:
            https://myapi.gateway.celerium.org/V1.0/Companies/query?search=...

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Test-AutoTaskAPIKey.html
#>

    [CmdletBinding(DefaultParameterSetName = 'Test')]
    Param (
        [Parameter(Mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        [string]$BaseURI = $AutoTaskModuleBaseUri
    )

    begin {
        $Search         = '{"MaxRecords":1,"IncludeFields":["id"],"filter":[{"op":"gte","field":"id","value":0}]}'
        $ResourceUri    = '/V1.0/Companies/query?search=' + [System.Uri]::EscapeDataString($Search)
    }

    process {

        $ApiKey = Get-AutoTaskAPIKey -AsPlainText -WarningAction SilentlyContinue

        if ([bool]$BaseURI -eq $false -or [bool]$ApiKey -eq $false) {
            Write-Error "The BaseURI and or API values are not set. Please run the Add-AutoTaskAPIKey & Add-AutoTaskBaseURI cmdlets before running this function"
            return
        }

        $TargetUri = ($BaseURI.TrimEnd('/') -replace '(?i)/v\d+(\.\d+)?$', '') + $ResourceUri
        Write-Verbose "Testing API values against [ $TargetUri ]"

        # Windows PowerShell does not always negotiate TLS 1.2 by default
        if ($PSEdition -eq 'Desktop') {
            [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        }

        try {

            $Headers = @{
                'ApiIntegrationCode'    = $ApiKey.ApiIntegrationCode
                'UserName'              = $ApiKey.Username
                'Secret'                = $ApiKey.Password
                'Accept'                = 'application/json'
            }

            $Parameters = @{
                'Method'            = 'GET'
                'Uri'               = $TargetUri
                'Headers'           = $Headers
                'UserAgent'         = $AutoTaskModuleUserAgent
                'UseBasicParsing'   = $true
            }

            $RestOutput = Invoke-WebRequest @Parameters -ErrorAction Stop

        }
        catch {

            # Windows PowerShell exposes StatusDescription, PowerShell Core exposes ReasonPhrase
            $Description = if ($PSEdition -eq 'Desktop') { $_.Exception.Response.StatusDescription } else { $_.Exception.Response.ReasonPhrase }

            [PSCustomObject]@{
                Method              = 'GET'
                StatusCode          = [int]$_.Exception.Response.StatusCode
                StatusDescription   = $Description
                Message             = $_.Exception.Message
                URI                 = $TargetUri
            }

        }
        finally {
            $Headers    = $null
            $ApiKey     = $null
        }

        if ($RestOutput) {

            [PSCustomObject]@{
                StatusCode          = [int]$RestOutput.StatusCode
                StatusDescription   = $RestOutput.StatusDescription
                URI                 = $TargetUri
            }

        }

    }

    end {}

}
#EndRegion '.\Private\ApiKeys\Test-AutoTaskAPIKey.ps1' 131
#Region '.\Private\BaseUri\Add-AutoTaskBaseURI.ps1' -1

function Add-AutoTaskBaseURI {
<#
    .SYNOPSIS
        Sets the base URI for the AutoTask API connection

    .DESCRIPTION
        The Add-AutoTaskBaseURI cmdlet sets the base URI which is used
        to construct the full URI for all API calls

        The base URI is the zone url of the AutoTask API without the API version,
        such as https://webservices24.autotask.net/atservicesrest

        The API version such as /V1.0 is part of each resource path, a base URI
        that ends with an API version is accepted & the version is removed

    .PARAMETER AutoDetect
        Automatically detects the base URI (zone) of the AutoTask API user

        The username set by Add-AutoTaskAPIKey is used to make a single unauthenticated
        GET request to the AutoTask ZoneInformation endpoint

        This is the default when no other parameter is used

    .PARAMETER Version
        Defines the API version that is stored with the base URI & used by -AutoDetect

        Default value: V1.0

    .PARAMETER BaseURI
        Sets the base URI for the AutoTask API connection. Helpful
        if using a custom API gateway or an undocumented AutoTask API endpoint

        The URL must use https

    .PARAMETER DataCenter
        Defines the data center (zone) to use which in turn defines which
        base API URL is used

        https://www.autotask.net/help/developerhelp/Content/APIs/General/API_Zones.htm

        Allowed values are:
        America East                    https://webservices3.autotask.net/atservicesrest
        America East 2                  https://webservices14.autotask.net/atservicesrest
        America East 3                  https://webservices22.autotask.net/atservicesrest
        America West                    https://webservices5.autotask.net/atservicesrest
        America West 2                  https://webservices15.autotask.net/atservicesrest
        America West 3                  https://webservices24.autotask.net/atservicesrest
        America West 4                  https://webservices25.autotask.net/atservicesrest
        Australia / New Zealand         https://webservices6.autotask.net/atservicesrest
        Australia 2                     https://webservices26.autotask.net/atservicesrest
        Australia 3                     https://webservices29.autotask.net/atservicesrest
        Deutsch German                  https://webservices18.autotask.net/atservicesrest
        Deutsch Pre-Release             https://prde.autotask.net/atservicesrest
        Español Pre-Release             https://pres.autotask.net/atservicesrest
        Español Spanish                 https://webservices12.autotask.net/atservicesrest
        EU1 (English Europe and Asia)   https://webservices19.autotask.net/atservicesrest
        Limited Release                 https://webservices1.autotask.net/atservicesrest
        Pre-release                     https://webservices2.autotask.net/atservicesrest
        UK                              https://webservices4.autotask.net/atservicesrest
        UK Limited Release              https://webservices17.autotask.net/atservicesrest
        UK Pre-release                  https://webservices11.autotask.net/atservicesrest
        UK2                             https://webservices16.autotask.net/atservicesrest
        UK3                             https://webservices28.autotask.net/atservicesrest

    .EXAMPLE
        Add-AutoTaskBaseURI

        Detects the base URI of the API user that was set by Add-AutoTaskAPIKey

    .EXAMPLE
        Add-AutoTaskBaseURI -BaseURI 'https://gateway.celerium.org'

        The base URI will use https://gateway.celerium.org

    .EXAMPLE
        Add-AutoTaskBaseURI -DataCenter 'America West 3'

        The base URI will use https://webservices24.autotask.net/atservicesrest

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Add-AutoTaskBaseURI.html
#>

    [CmdletBinding(DefaultParameterSetName = 'AutoDetect')]
    [Alias('Set-AutoTaskBaseURI')]
    Param (
        [Parameter(Mandatory = $false, ParameterSetName = 'AutoDetect')]
        [switch]$AutoDetect,

        [Parameter(Mandatory = $false)]
        [ValidatePattern('^[Vv]\d+(\.\d+)?$')]
        [string]$Version = 'V1.0',

        [Parameter(Mandatory = $true, ValueFromPipeline = $true, Position = 0, ParameterSetName = 'CustomUri')]
        [ValidateNotNullOrEmpty()]
        [string]$BaseURI,

        [Parameter(Mandatory = $true, ParameterSetName = 'DataCenter')]
        [ValidateSet(
            'America East',
            'America East 2',
            'America East 3',
            'America West',
            'America West 2',
            'America West 3',
            'America West 4',
            'Australia / New Zealand',
            'Australia 2',
            'Australia 3',
            'Deutsch German',
            'Deutsch Pre-Release',
            'Español Pre-Release',
            'Español Spanish',
            'EU1 (English Europe and Asia)',
            'Limited Release',
            'Pre-release',
            'UK',
            'UK Limited Release',
            'UK Pre-release',
            'UK2',
            'UK3'
        )]
        [Alias('Platform')]
        [string]$DataCenter
    )

    begin {}

    process {

        switch ($PSCmdlet.ParameterSetName) {

            'AutoDetect' {

                if (-not $AutoTaskModuleApiUsername) {
                    throw "The AutoTask API username is not set. Run Add-AutoTaskAPIKey first or use the -DataCenter or -BaseURI parameter"
                }

                # Windows PowerShell does not always negotiate TLS 1.2 by default
                if ($PSEdition -eq 'Desktop') {
                    [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
                }

                Write-Verbose "Detecting the base URI of the API user (AutoDetect: $([bool]$AutoDetect))"

                try {
                    $ValidationUri  ="https://webservices2.autotask.net/atservicesrest/$Version/ZoneInformation?user=$([System.Uri]::EscapeDataString($AutoTaskModuleApiUsername))"
                    $BaseURI        = (Invoke-RestMethod -Uri $ValidationUri -Method GET -UserAgent $AutoTaskModuleUserAgent -ErrorAction Stop).url
                }
                catch {
                    throw "Could not detect the AutoTask base URI, use the -DataCenter or -BaseURI parameter - $($_.Exception.Message)"
                }

                if (-not $BaseURI) { throw 'Could not detect the AutoTask base URI, use the -DataCenter or -BaseURI parameter' }

            }

            'DataCenter' {

                $BaseURI = switch ($DataCenter) {
                    'America East'                  { 'https://webservices3.autotask.net/atservicesrest' }
                    'America East 2'                { 'https://webservices14.autotask.net/atservicesrest' }
                    'America East 3'                { 'https://webservices22.autotask.net/atservicesrest' }
                    'America West'                  { 'https://webservices5.autotask.net/atservicesrest' }
                    'America West 2'                { 'https://webservices15.autotask.net/atservicesrest' }
                    'America West 3'                { 'https://webservices24.autotask.net/atservicesrest' }
                    'America West 4'                { 'https://webservices25.autotask.net/atservicesrest' }
                    'Australia / New Zealand'       { 'https://webservices6.autotask.net/atservicesrest' }
                    'Australia 2'                   { 'https://webservices26.autotask.net/atservicesrest' }
                    'Australia 3'                   { 'https://webservices29.autotask.net/atservicesrest' }
                    'Deutsch German'                { 'https://webservices18.autotask.net/atservicesrest' }
                    'Deutsch Pre-Release'           { 'https://prde.autotask.net/atservicesrest' }
                    'Español Pre-Release'           { 'https://pres.autotask.net/atservicesrest' }
                    'Español Spanish'               { 'https://webservices12.autotask.net/atservicesrest' }
                    'EU1 (English Europe and Asia)' { 'https://webservices19.autotask.net/atservicesrest' }
                    'Limited Release'               { 'https://webservices1.autotask.net/atservicesrest' }
                    'Pre-release'                   { 'https://webservices2.autotask.net/atservicesrest' }
                    'UK'                            { 'https://webservices4.autotask.net/atservicesrest' }
                    'UK Limited Release'            { 'https://webservices17.autotask.net/atservicesrest' }
                    'UK Pre-release'                { 'https://webservices11.autotask.net/atservicesrest' }
                    'UK2'                           { 'https://webservices16.autotask.net/atservicesrest' }
                    'UK3'                           { 'https://webservices28.autotask.net/atservicesrest' }
                }

            }

        }

        $ParsedUri = $null
        if (-not [System.Uri]::TryCreate($BaseURI.Trim(), [System.UriKind]::Absolute, [ref]$ParsedUri) -or $ParsedUri.Scheme -ne 'https') {
            throw "The base URI [ $BaseURI ] is not valid, it must be an absolute https url such as https://webservices24.autotask.net/atservicesrest"
        }

        # The query string, a trailing slash, & a trailing API version are removed
        $NormalizedUri = ($ParsedUri.GetLeftPart([System.UriPartial]::Path)).TrimEnd('/') -replace '(?i)/v\d+(\.\d+)?$', ''

        Write-Verbose "Using URI: [ $NormalizedUri ]"

        Set-Variable -Name 'AutoTaskModuleBaseUri'              -Value $NormalizedUri               -Option ReadOnly -Scope Global -Force
        Set-Variable -Name 'AutoTaskModuleBaseUriApiVersion'    -Value $Version                     -Option ReadOnly -Scope Global -Force
        Set-Variable -Name 'AutoTaskModuleBaseUriComplete'      -Value "$NormalizedUri/$Version"    -Option ReadOnly -Scope Global -Force

    }

    end {}

}
#EndRegion '.\Private\BaseUri\Add-AutoTaskBaseURI.ps1' 211
