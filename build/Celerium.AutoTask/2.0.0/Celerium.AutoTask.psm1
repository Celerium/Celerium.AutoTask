#Region '.\Private\ApiCalls\Get-AutoTaskResourceOperation.ps1' -1

function Get-AutoTaskResourceOperation {
<#
    .SYNOPSIS
        Gets the operations of an AutoTask resource

    .DESCRIPTION
        The Get-AutoTaskResourceOperation cmdlet returns the operations from the resource map
        and can limit them to one resource and to the operations that a public function supports

        Every operation of the AutoTask API is supported by one of the public functions:

            Get-AutoTaskResource    - GET operations & the POST query & count operations
            New-AutoTaskBody        - The QueryFieldDefinitions operation
            New-AutoTaskResource    - The CreateEntity operation & the other POST operations
            Set-AutoTaskResource    - The PATCH & PUT operations
            Remove-AutoTaskResource - The DELETE operations

    .PARAMETER Resource
        Defines the name of the resource to return the operations of, such as Companies

        The name is not case sensitive

    .PARAMETER CommandName
        Defines the public function to return the supported operations of

        Allowed values:
            'Get-AutoTaskResource', 'New-AutoTaskBody', 'New-AutoTaskResource',
            'Set-AutoTaskResource', 'Remove-AutoTaskResource'

    .EXAMPLE
        Get-AutoTaskResourceOperation -Resource Companies

        Returns every operation of the Companies resource

    .EXAMPLE
        Get-AutoTaskResourceOperation -CommandName Remove-AutoTaskResource

        Returns every operation that the Remove-AutoTaskResource function supports

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Get-AutoTaskResourceOperation.html
#>

    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    Param (
        [Parameter(Mandatory = $false)]
        [string]$Resource,

        [Parameter(Mandatory = $false)]
        [ValidateSet('Get-AutoTaskResource', 'New-AutoTaskBody', 'New-AutoTaskResource', 'Set-AutoTaskResource', 'Remove-AutoTaskResource')]
        [string]$CommandName
    )

    begin {}

    process {

        $Operations = Get-AutoTaskResourceMap

        if ($Resource) {

            # A case insensitive lookup by resource name is created once per session
            if (-not $script:AutoTaskModuleResourceIndex) {
                $Index = @{}
                foreach ($Entry in $Operations) {
                    if (-not $Index.ContainsKey($Entry.Resource)) { $Index[$Entry.Resource] = [System.Collections.Generic.List[object]]::new() }
                    $Index[$Entry.Resource].Add($Entry)
                }
                $script:AutoTaskModuleResourceIndex = $Index
            }

            $Operations = if ($script:AutoTaskModuleResourceIndex.ContainsKey($Resource)) { $script:AutoTaskModuleResourceIndex[$Resource].ToArray() } else { @() }

        }

        switch ($CommandName) {
            'Get-AutoTaskResource'      { $Operations = $Operations | Where-Object { ($_.Method -eq 'GET' -and $_.Operation -ne 'CreateEntity') -or ($_.Method -eq 'POST' -and $_.Operation -in 'Query', 'QueryCount') } }
            'New-AutoTaskBody'          { $Operations = $Operations | Where-Object { $_.Operation -eq 'QueryFieldDefinitions' } }
            'New-AutoTaskResource'      { $Operations = $Operations | Where-Object { $_.Operation -eq 'CreateEntity' -or ($_.Method -eq 'POST' -and $_.Operation -notin 'Query', 'QueryCount') } }
            'Set-AutoTaskResource'      { $Operations = $Operations | Where-Object { $_.Method -in 'PATCH', 'PUT' } }
            'Remove-AutoTaskResource'   { $Operations = $Operations | Where-Object { $_.Method -eq 'DELETE' } }
        }

        $Operations

    }

    end {}

}
#EndRegion '.\Private\ApiCalls\Get-AutoTaskResourceOperation.ps1' 95
#Region '.\Private\ApiCalls\Get-AutoTaskSpecOperation.ps1' -1

function Get-AutoTaskSpecOperation {
<#
    .SYNOPSIS
        Gets every operation from an AutoTask OpenAPI (swagger) spec

    .DESCRIPTION
        The Get-AutoTaskSpecOperation cmdlet reads an AutoTask OpenAPI (swagger) spec
        and returns one object per operation (HTTP method & path)

        The resource is the tag of the operation, such as Companies or CompanyAlertsChild,
        and the operation is the part of the operationId after the resource name, such as
        Query, QueryItem, CreateEntity, PatchEntity, or DeleteEntity

        This function is used by the build\New-AutoTaskResourceMap.ps1 script to create
        the resource map of the module & by Show-AutoTaskResource -JsonSpec

    .PARAMETER JsonSpec
        Defines the path to the AutoTask OpenAPI (swagger) json file

    .PARAMETER Spec
        Defines an AutoTask OpenAPI (swagger) spec that was already converted from JSON

    .EXAMPLE
        Get-AutoTaskSpecOperation -JsonSpec .\Celerium.AutoTask\AutoTaskAPI-2023.6.json

        Returns every operation of the spec

    .EXAMPLE
        Get-AutoTaskSpecOperation -JsonSpec .\AutoTaskAPI-2023.6.json | Where-Object { $_.Resource -eq 'Companies' }

        Returns the operations of the Companies resource

    .NOTES
        N/A

    .LINK
        https://celerium.github.io/Celerium.AutoTask/site/Internal/Get-AutoTaskSpecOperation.html
#>

    [CmdletBinding(DefaultParameterSetName = 'File')]
    [OutputType([PSCustomObject])]
    Param (
        [Parameter(Mandatory = $true, ParameterSetName = 'File')]
        [ValidateNotNullOrEmpty()]
        [string]$JsonSpec,

        [Parameter(Mandatory = $true, ParameterSetName = 'Object')]
        [ValidateNotNull()]
        [PSObject]$Spec
    )

    begin {}

    process {

        if ($PSCmdlet.ParameterSetName -eq 'File') {
            if (-not (Test-Path -Path $JsonSpec -PathType Leaf)) {
                throw "The OpenAPI spec was not found at [ $JsonSpec ]"
            }
            $Spec = [System.IO.File]::ReadAllText((Resolve-Path -Path $JsonSpec).ProviderPath, [System.Text.Encoding]::UTF8).TrimStart([char]0xFEFF) | ConvertFrom-Json
        }

        if (-not $Spec.paths) { throw 'The OpenAPI spec does not have any paths' }

        $Operations = foreach ($Path in $Spec.paths.PSObject.Properties) {
            foreach ($Method in 'get', 'post', 'put', 'patch', 'delete') {

                $Definition = $Path.Value.PSObject.Properties[$Method]
                if (-not $Definition) { continue }

                $Tag            = @($Definition.Value.tags)[0]
                $OperationId    = "$($Definition.Value.operationId)"

                # The operationId is <Tag>_<Operation>, such as Companies_QueryItem
                $Resource   = if ($Tag) { "$Tag" } else { ($OperationId -split '_', 2)[0] }
                $Operation  = if ($OperationId -like "$($Resource)_*") { $OperationId.Substring($Resource.Length + 1) }
                              elseif ($OperationId -match '_') { ($OperationId -split '_', 2)[1] }
                              else { $OperationId }

                [PSCustomObject]@{
                    Resource    = $Resource
                    Operation   = $Operation
                    Method      = $Method.ToUpperInvariant()
                    Path        = $Path.Name
                }

            }
        }

        # Ordinal sorting keeps the order identical on every platform & culture
        $Sorted = [System.Collections.Generic.List[object]]::new()
        $Sorted.AddRange(@($Operations))
        $Sorted.Sort([System.Comparison[object]]{
            param ($Left, $Right)
            $Result = [string]::CompareOrdinal($Left.Resource, $Right.Resource)
            if ($Result -eq 0) { $Result = [string]::CompareOrdinal($Left.Operation, $Right.Operation) }
            if ($Result -eq 0) { $Result = [string]::CompareOrdinal($Left.Method, $Right.Method) }
            return $Result
        })

        $Sorted

    }

    end {}

}
